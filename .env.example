# Local UX only. Use fictional input; no real account is created or contacted.
# Unset: demo during next dev, disabled during next start/production.
# Explicit demo is restricted to loopback hosts. Never use it as authentication.
CARRYLINK_AUTH_MODE=demo

# Reserved for a future, approved Supabase adapter. Currently unused; blank is safe.
# Selecting CARRYLINK_AUTH_MODE=supabase fails closed in this phase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Configure Google credentials, SMTP and SMS credentials in the provider's secure
# settings after approval. Do not put service-role keys or secrets in NEXT_PUBLIC_*.
# No email/SMS provider is selected and no sending configuration is read by this app.
